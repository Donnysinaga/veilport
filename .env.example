# VEILPORT — Environment Variables Configuration Template
# Copy this file to .env.local for local overrides, or set these in the Vercel Project Settings.

# Network RPC Configuration (Optional: default public RPC is built-in)
NEXT_PUBLIC_RPC_URL=https://rpc-robinhood.blockmachine.io
NEXT_PUBLIC_RPC_FALLBACK_URL=https://robinhood.rpc.blxrbdn.com

# WalletConnect Cloud Project ID (Optional: default public testing project ID is included)
# Obtain a dedicated project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# Shielded Privacy Pool Contracts (Optional: unconfigured by default for safety until production verification)
# Once pools are deployed on target networks, provide verified non-zero EVM addresses here:
# NEXT_PUBLIC_ETH_01_POOL=0x...
# NEXT_PUBLIC_ETH_10_POOL=0x...
# NEXT_PUBLIC_ETH_100_POOL=0x...
# NEXT_PUBLIC_USDG_100_POOL=0x...
# NEXT_PUBLIC_USDG_1000_POOL=0x...
# NEXT_PUBLIC_USDG_10000_POOL=0x...
